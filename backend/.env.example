# ── FlightTerm Backend Environment ─────────────────────────────────────────────
# Copy this file to .env and fill in your keys.
# .env is gitignored — your keys never leave this machine.
#
# For Fly.io production, set these via: fly secrets set KEY=value

# ── Data Sources ──────────────────────────────────────────────────────────────

# FlightAware AeroAPI — paid, hard-capped at $5/month in code
AEROAPI_KEY=your_flightaware_aeroapi_key

# OpenSky Network — free tier, 4000 credits/day per key
# Primary key (required for OpenSky data)
OS_CLIENT_ID=your_opensky_client_id
OS_CLIENT_SECRET=your_opensky_client_secret
# Secondary key (optional) — auto-failover when primary runs low (<100 credits)
# With both keys: 8000 credits/day total
OS_CLIENT_ID_2=
OS_CLIENT_SECRET_2=

# FAA NOTAM API — register free at https://api.faa.gov/s/
FAA_CLIENT_ID=your_faa_client_id
FAA_CLIENT_SECRET=your_faa_client_secret

# ── S3 Archive (optional) ────────────────────────────────────────────────────
# Archive old daily summaries to S3 to save DB space.
# If S3_BUCKET is not set, archival is disabled and daily data stays in SQLite.
S3_BUCKET=your-bucket-name
S3_REGION=us-east-1
S3_PREFIX=flightterm/
S3_ARCHIVE_DAYS=30
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# ── Correlation layer — v2.0.0 ────────────────────────────────────────────────
# These augment the flight track with external context. Each endpoint degrades
# gracefully if its key is missing — the aircraft /context response just omits
# the corresponding section.

# NASA FIRMS active-fire pixels (VIIRS/MODIS). Free map key.
# https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# OpenWeatherMap current weather at an aircraft's lat/lon.
# https://home.openweathermap.org/users/sign_up
OPENWEATHERMAP_KEY=

# OpenAQ v3 air-quality monitors near aircraft lat/lon.
# https://explore.openaq.org/register
OPENAQ_KEY=

# AISStream.io maritime AIS (WebSocket). Reserved — not wired in v2.0.0.
AISSTREAM_KEY=

# Mapillary street-level imagery for visual corroboration.
# https://www.mapillary.com/developer
MAPILLARY_ACCESS_TOKEN=

# NPS webcams — National Park Service cam directory.
# https://www.nps.gov/subjects/developer/get-started.htm
NPS_KEY=

# 511 SF Bay Area traffic cams + incidents.
# https://511.org/open-data
FIVEONE_SFBAY_TOKEN=

# Sentinel Hub (Copernicus Dataspace) — satellite imagery WMS.
# OAuth2 client-credentials. Token TTL 30 min; adapter caches.
# https://shapps.dataspace.copernicus.eu/dashboard/
SENTINEL_CLIENT_ID=
SENTINEL_CLIENT_SECRET=

# ── Server ────────────────────────────────────────────────────────────────────

PORT=3001

# CORS — comma-separated allowed origins. Defaults to * (allow all).
# For production, set to your domain(s):
#   CORS_ORIGIN=https://flightterm.fly.dev
#   CORS_ORIGIN=https://flightterm.fly.dev,https://yourdomain.com
# CORS_ORIGIN=

# ── Anomaly Poller ────────────────────────────────────────────────────────────
# Backend anomaly detection — runs scoring loop on POLL_INTERVAL.
# Set to true to enable. The poller fetches flights and scores them server-side.
POLLER_ENABLED=false
# POLL_INTERVAL=45000    # ms between poll cycles (default: 45000)
# AIRPLANES_LIVE_PRIMARY=false  # true skips slow OpenSky first on hosts where OpenSky times out
# AIRPLANES_LIVE_FALLBACK_DISABLED=false
# AIRPLANES_LIVE_BASE=https://api.airplanes.live/v2

# v5.2.1 — STRONGLY RECOMMENDED: set ANOMALY_DETECTION_ENABLED=true.
# When false, the poller is write-only: no sightings persist, no anomalies
# score, and the "Now Showing" feed has only callsign + route signals —
# no orbit detection, no multi-signal corroboration. Measured impact on a
# live CONUS dataset: multi-source feed items 0 → 9, orbit signal 0 → 13,
# military signal 0 → 9, route-dev noise 13 → 0 (all in the top 20).
ANOMALY_DETECTION_ENABLED=true

# ── Wealth-Signal Business Jet Early Warning ─────────────────────────────────
# Runs a fixed FAA-registry cohort of high-end/large-cabin business jets.
# Best source is a tar1090/readsb aircraft.json or aircraft.json.gz heatmap.
# If omitted, the tracker falls back to the app poller cache.
# BUSINESS_JET_TRACKER_DISABLED=false
# BUSINESS_JET_TRACKER_INTERVAL_MS=1800000  # hard minimum: one stored snapshot per 30-minute bucket
# BUSINESS_JET_HEATMAP_URL=https://example.com/tar1090/data/aircraft.json
# BUSINESS_JET_HISTORY_URL_TEMPLATE=https://example.com/history/{yyyy}/{MM}/{dd}/{HH}{mm}{ss}Z.json.gz
# BUSINESS_JET_BASELINE_DAYS=365
# BUSINESS_JET_BASELINE_WINDOW_MINUTES=180
# BUSINESS_JET_COHORT_MAX_SEATS=32

# ── Security ──────────────────────────────────────────────────────────────────

# Admin secret — protects POST /api/poller/start and /api/poller/stop.
# Pass as header:  x-admin-secret: <value>
# If not set, those routes return 403. Poller still auto-starts via POLLER_ENABLED.
ADMIN_SECRET=

# ── Rate Limiting & Abuse Prevention ─────────────────────────────────────────
# All values below have sensible defaults — only set to override.

# RATE_WINDOW_MS=60000       # time window in ms (default: 1 minute)
# RATE_MAX=100               # max requests per window per IP (default: 100)
# SSE_MAX_PER_IP=5           # max concurrent SSE connections per IP (default: 5)
# SSE_TIMEOUT_MS=300000      # auto-close SSE after this long in ms (default: 5 min)
# POST_MAX_ITEMS=2000        # max items in POST arrays — sightings, routes (default: 2000)
