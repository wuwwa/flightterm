# ── SWIM worker service (no SQLite, no build tools) ────────────────────────
FROM node:20-slim
WORKDIR /app

# Copy minimal package.json and install deps
COPY backend/package-swim.json package.json
RUN npm install --omit=dev

# Copy worker entry point + swim modules + anomaly (for AIRPORTS list)
COPY backend/swim-service.js .
COPY backend/swim/ swim/
COPY backend/anomaly.js .

ENV PORT=3002
EXPOSE 3002

CMD ["node", "swim-service.js"]
